FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    nmap \
    nikto \
    sslscan \
    curl \
    wget \
    python3 \
    python3-pip \
    openssh-client \
    openssl \
    netcat-openbsd \
    dnsutils \
    iputils-ping \
    && pip3 install --break-system-packages ssh-audit \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /results
ENTRYPOINT ["sleep", "infinity"]
