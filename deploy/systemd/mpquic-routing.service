[Unit]
Description=MPQUIC client policy routing refresh
After=network-online.target mpquic@1.service mpquic@2.service mpquic@3.service mpquic@4.service mpquic@5.service mpquic@6.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/mpquic-policy-routing.sh
# RemainAfterExit deve restare "no": con "yes" la unit resta active (exited)
# e il timer di riconciliazione non la rieseguirebbe mai (systemd avvia via
# timer solo unit inattive). Lo script e' idempotente, rieseguirlo e' gratis.
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
