# TUN mpq2 — route persistente in table wan2 (101)
# Ripristina automaticamente "default dev mpq2 scope link table 101"
# ogni volta che mpquic@2 ricrea il device TUN con un nuovo ifindex.
[Match]
Name=mpq2

[Network]
LinkLocalAddressing=no
IPv6AcceptRA=no

[Route]
Destination=0.0.0.0/0
Table=101
Scope=link
