# TUN mpq1 — route persistente in table wan1 (100)
# Ripristina automaticamente "default dev mpq1 scope link table 100"
# ogni volta che mpquic@1 ricrea il device TUN con un nuovo ifindex.
[Match]
Name=mpq1

[Network]
LinkLocalAddressing=no
IPv6AcceptRA=no

[Route]
Destination=0.0.0.0/0
Table=100
Scope=link
