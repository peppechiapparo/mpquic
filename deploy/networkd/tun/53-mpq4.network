# TUN mpq4 — route persistente in table wan4 (103)
# Ripristina automaticamente "default dev mpq4 scope link table 103"
# ogni volta che mpquic@4 ricrea il device TUN con un nuovo ifindex.
[Match]
Name=mpq4

[Network]
LinkLocalAddressing=no
IPv6AcceptRA=no

[Route]
Destination=0.0.0.0/0
Table=103
Scope=link
