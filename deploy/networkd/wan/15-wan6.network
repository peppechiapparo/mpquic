# WAN6 — enp7s8 (Starlink #2)
[Match]
Name=enp7s8

[Network]
DHCP=yes
IPv6AcceptRA=no
LinkLocalAddressing=no
KeepConfiguration=no

[DHCP]
RouteMetric=106
UseDNS=no
UseRoutes=yes
SendRelease=yes
ClientIdentifier=mac

# TS-028: niente default fisico in main (era il bypass implicito TS-017).
# Il gateway resta noto dal lease (/run/systemd/netif/leases) e lo script
# lo copia nella sola tabella phyN; l'uscita VPS dei tunnel passa dalle
# rule remote 120x verso le host route di tabella wanN.
# NB: UseGateway esiste solo nella sezione [DHCPv4] — nella legacy [DHCP]
# systemd 252 la ignora con "Unknown key" (verificato sul campo).
[DHCPv4]
UseGateway=false

[Link]
RequiredForOnline=no
