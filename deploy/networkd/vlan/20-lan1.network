[Match]
Name=enp6s20

[Network]
VLAN=enp6s20.17
Address=172.16.1.1/30
LinkLocalAddressing=no
IPv6AcceptRA=no

# Wan rule statica del policy routing (TS-020/storm 2026-07-27):
# di proprieta networkd, presente dal boot, immune allo sweep delle rule foreign.
[RoutingPolicyRule]
From=172.16.1.0/30
Table=100
Priority=1001

# Pavimento blackhole per wan1: se il default dinamico dev mpq1 sparisce
# (TUN distrutto, tunnel giu) il traffico del /30 muore qui invece di
# scavalcare in main sul default fisico (bypass visto il 2026-07-27).
[Route]
Type=blackhole
Destination=0.0.0.0/0
Table=100
Metric=9999
